    pages[name] = {page = page, layout = layout, accent = btnAccent, text = btnText}
    table.insert(tabButtons, {name = name, btn = btn, stroke = tabBarStroke, data = pages[name]})
    return page, layout
end

local function switchTab(name)
    if currentTab == name then return end
    currentTab = name
    for tabName, data in pairs(pages) do
        data.page.Visible = (tabName == name)
        if tabName == name then
            TweenService:Create(data.accent, TweenInfo.new(0.2), {BackgroundColor3 = state.accentColor}):Play()
            TweenService:Create(data.text, TweenInfo.new(0.2), {TextColor3 = COL_TEXT}):Play()
            TweenService:Create(data.page.Parent, TweenInfo.new(0.2), {}):Play()
        else
            TweenService:Create(data.accent, TweenInfo.new(0.2), {BackgroundColor3 = COL_BORDER}):Play()
            TweenService:Create(data.text, TweenInfo.new(0.2), {TextColor3 = COL_TEXT_DIM}):Play()
        end
    end
end

