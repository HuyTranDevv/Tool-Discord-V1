-- ================== LOCK PART ==================
local function getLockPart(char)
    if not char then return nil end
    if state.lockPart == "Head" then
        return char:FindFirstChild("Head")
    elseif state.lockPart == "Torso" then
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    elseif state.lockPart == "Legs" then
        local lt = char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("Left Leg")
        if lt then return lt end
        return char:FindFirstChild("HumanoidRootPart")
    end
    return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end

local function getLockPosition(char)
    local part = getLockPart(char)
    if not part then return nil end
    local pos = part.Position
    if state.lockPart == "Legs" then pos = pos + Vector3.new(0, -1.5, 0) end
    return pos
end

local function getPredictedPosition(plr, partPos)
    if not state.predictionEnabled then return partPos end
    local char = plr.Character
    if not char then return partPos end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return partPos end
    return partPos + hrp.AssemblyLinearVelocity * state.predictionAmount
end

local function isSameTeam(plr)
    if not state.ignoreTeam then
        local mt, tt = LP.Team, plr.Team
        if mt and tt and mt == tt then return true end
    end
    return false
end

-- ================== TARGET ==================
local function getFrontPlayer()
    local center = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)
    local camPos = Cam.CFrame.Position
    local best, bestScore = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and not isSameTeam(plr) and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and hrp then
                local sp, onScreen = Cam:WorldToViewportPoint(hrp.Position)
                if onScreen and sp.Z > 0 then
                    local screenDist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if screenDist <= state.fov then
                        local score
                        if state.priority == "Center" then score = screenDist
                        elseif state.priority == "Nearest" then score = (hrp.Position - camPos).Magnitude
                        elseif state.priority == "LowHP" then score = hum.Health end
                        if score < bestScore then bestScore = score; best = plr end
                    end
                end
            end
        end
    end
    return best
end

-- ================== CAMLOCK ==================
local function camlockStep()
    if not state.camlockEnabled then return end
    local char = LP.Character; if not char then return end
    local myHRP = char:FindFirstChild("HumanoidRootPart"); if not myHRP then return end
    local t = state.target; if not t or not t.Character then return end
    local hum = t.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    local partPos = getLockPosition(t.Character)
    if not partPos then return end
    partPos = getPredictedPosition(t, partPos)
    if not state.lockedOffset then state.lockedOffset = Cam.CFrame.Position - myHRP.Position end
    local newCamPos = myHRP.Position + state.lockedOffset
    local targetLook = (partPos - newCamPos)
    if targetLook.Magnitude < 0.01 then return end
    targetLook = targetLook.Unit
    local newLook = Cam.CFrame.LookVector:Lerp(targetLook, state.smoothness)
    if newLook.Magnitude < 0.01 then return end
    newLook = newLook.Unit
    Cam.CFrame = CFrame.lookAt(newCamPos, newCamPos + newLook)
end

local function startCamlock()
    state.camlockEnabled = true
    state.lockedOffset = nil
    Cam.CameraType = Enum.CameraType.Scriptable
    RunService:BindToRenderStep("CountrickedCamlock", Enum.RenderPriority.Camera.Value + 1, camlockStep)
    local t = getFrontPlayer()
    if t then state.target = t end
end

local function stopCamlock()
    state.camlockEnabled = false
    state.target = nil
    state.lockedOffset = nil
    RunService:UnbindFromRenderStep("CountrickedCamlock")
    Cam.CameraType = Enum.CameraType.Custom
end

local function toggleCamlock() if state.camlockEnabled then stopCamlock() else startCamlock() end end

-- ================== AUTO SHOOT ==================
local function doClick()
    if state.moveMouseToCenter then
        local cx = Cam.ViewportSize.X / 2
        local cy = Cam.ViewportSize.Y / 2
        if mousemoveabs then pcall(mousemoveabs, cx, cy)
        elseif mousemoverel then
            local cur = UIS:GetMouseLocation()
            pcall(mousemoverel, cx - cur.X, cy - cur.Y)
        end
    end
    if state.useActivate then
        local char = LP.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then pcall(function() tool:Activate() end); return end
        end
    end
    if mouse1click then pcall(mouse1click)
    elseif mouse1press and mouse1release then
        pcall(function() mouse1press(); task.wait(0.02); mouse1release() end)
    end
end

