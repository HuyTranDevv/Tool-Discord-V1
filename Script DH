-- ================== FPS BOOST ==================
local savedData = {effects = {}, decals = {}, materials = {}, settings = {}}

local function applyFpsBoost()
    state.fpsBoost = true
    local L = Lighting
    savedData.settings = {
        GlobalShadows = L.GlobalShadows, FogEnd = L.FogEnd, Brightness = L.Brightness,
        EnvironmentDiffuseScale = L.EnvironmentDiffuseScale,
        EnvironmentSpecularScale = L.EnvironmentSpecularScale,
    }
    L.GlobalShadows = false; L.FogEnd = 1e6; L.Brightness = 0
    L.EnvironmentDiffuseScale = 0; L.EnvironmentSpecularScale = 0
    for _, v in ipairs(L:GetChildren()) do
        if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Sky") then
            savedData.effects[v] = v.Enabled
            pcall(function() v.Enabled = false end)
        end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Decal") or obj:IsA("Texture") then
            if obj.Transparency < 1 then savedData.decals[obj] = obj.Transparency; obj.Transparency = 1 end
        elseif obj:IsA("BasePart") then
            savedData.materials[obj] = obj.Material
            obj.Material = Enum.Material.SmoothPlastic
            if obj:IsA("MeshPart") and obj.TextureID ~= "" then
                savedData.decals[obj] = obj.TextureID
                obj.TextureID = ""
            end
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
            savedData.effects[obj] = obj.Enabled
            pcall(function() obj.Enabled = false end)
        end
    end
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
end

local function revertFpsBoost()
    state.fpsBoost = false
    for k, v in pairs(savedData.settings) do pcall(function() Lighting[k] = v end) end
    for obj, val in pairs(savedData.effects) do if obj and obj.Parent then pcall(function() obj.Enabled = val end) end end
    for obj, val in pairs(savedData.decals) do
        if obj and obj.Parent then
            pcall(function()
                if obj:IsA("MeshPart") then obj.TextureID = val else obj.Transparency = val end
            end)
        end
    end
    for obj, val in pairs(savedData.materials) do if obj and obj.Parent then pcall(function() obj.Material = val end) end end
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic end)
    savedData = {effects = {}, decals = {}, materials = {}, settings = {}}
end

