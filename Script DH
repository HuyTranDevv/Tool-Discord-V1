        btn.TextColor3 = active and Color3.fromRGB(0, 0, 0) or COL_TEXT
        btn.Font = FONT_B
        btn.TextSize = 10
        btn.AutoButtonColor = false
        btn.Parent = wrap
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 2)
        local bs = Instance.new("UIStroke", btn)
        bs.Color = active and state.accentColor or COL_BORDER
        bs.Thickness = 1

        btn.MouseButton1Click:Connect(function()
            setCurrent(opt)
            for j, other in ipairs(buttons) do
                local act = (opts[j] == opt)
