-- LOOPS
local function isMouseOverGUI()
    local m = UIS:GetMouseLocation()
    local p = main.AbsolutePosition
    local s = main.AbsoluteSize
    return m.X >= p.X and m.X <= p.X + s.X and m.Y >= p.Y and m.Y <= p.Y + s.Y
end

task.spawn(function()
    while task.wait(state.shootDelay) do
        if state.camlockEnabled and state.autoShoot and state.target and not isMouseOverGUI() then
            local t = state.target
            if t.Character then
                local hum = t.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then doClick() end
            end
        end
    end
end)

task.spawn(function()
    while task.wait(0.25) do
        if state.camlockEnabled then
            local t = state.target
            local need = false
            if not t or not t.Parent or not t.Character then
                need = true
            else
                local hum = t.Character:FindFirstChildOfClass("Humanoid")
                if not hum or hum.Health <= 0 then need = true end
            end
            if need then state.target = getFrontPlayer() end
        end
    end
end)

-- KEYBIND
local lastKeyState = false
RunService.RenderStepped:Connect(function()
    if state.waitingForKey then return end
    local kd = UIS:IsKeyDown(state.toggleKey)
    if kd and not lastKeyState then toggleCamlock() end
    lastKeyState = kd
end)

UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if state.waitingForKey then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            state.toggleKey = input.KeyCode
            stopKeybindCapture()
            log("Aim key changed to:", input.KeyCode.Name)
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
            stopKeybindCapture()
        end
    end
end)

